# Copy this file to .env. Configure one active model; do not commit real keys.

# Required for every provider.
WISPIVA_LLM_MODEL=

# Generic provider. Leave the URL and key blank to use the Qoder fallback below.
WISPIVA_LLM_BASE_URL=
WISPIVA_LLM_API_KEY=

# Qoder fallback for the URL and key above.
QODER_API_BASE_URL=https://api.qoder.com.cn
QODER_ACCESS_TOKEN=pt-xxxxxxxxxxxxxxxx

# Optional: responses (default) or chat-completions.
# WISPIVA_LLM_PROTOCOL=

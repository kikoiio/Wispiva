{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wispiva.invalid/genesis/v1",
  "$defs": {
    "storyObject": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "placeId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "at": {"type": "array", "items": {"type": "integer", "minimum": -4, "maximum": 4}, "minItems": 2, "maxItems": 2},
        "node": {"enum": ["default:chest", "default:furnace", "society:story_notice", "society:story_surface", "society:story_surface_disturbed"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?=\\S)[^\\u0000-\\u001f]+$"},
        "reach": {"type": "integer", "minimum": 1, "maximum": 4},
        "initialState": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "states": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "minItems": 1, "maxItems": 4, "uniqueItems": true},
        "renderByState": {"type": "object", "patternProperties": {"^[a-z][a-z0-9_-]{0,39}$": {"enum": ["default:chest", "default:furnace", "society:story_notice", "society:story_surface", "society:story_surface_disturbed"]}}, "additionalProperties": false, "minProperties": 1, "maxProperties": 4},
        "facets": {"type": "array", "items": {"$ref": "#/$defs/storyFacet"}, "minItems": 1, "maxItems": 8},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/storyGrant"}, "minItems": 0, "maxItems": 8},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/storyTransition"}, "minItems": 0, "maxItems": 4}
      },
      "required": ["id", "placeId", "at", "node", "label", "reach", "initialState", "states", "renderByState", "facets", "grants", "transitions"],
      "additionalProperties": false
    },
    "storyFacet": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "state": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?=\\S)[^\\u0000-\\u001f]+$"},
        "sourceRef": {"type": "string", "pattern": "^docs/source-texts/[a-z0-9/_-]+\\.txt#L[1-9][0-9]{0,4}-L[1-9][0-9]{0,4}$"},
        "epistemic": {"enum": ["observation", "inference", "author"]}
      },
      "required": ["id", "state", "text", "sourceRef", "epistemic"],
      "additionalProperties": false
    },
    "storyGrant": {
      "type": "object",
      "properties": {
        "actorId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "transitionIds": {"type": "array", "items": {"enum": ["continue_cellar_work"]}, "minItems": 1, "maxItems": 4, "uniqueItems": true}
      },
      "required": ["actorId", "transitionIds"],
      "additionalProperties": false
    },
    "storyTransition": {
      "type": "object",
      "properties": {
        "id": {"enum": ["continue_cellar_work"]},
        "from": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}
      },
      "required": ["id", "from", "to"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "storyObjects": {"type": "array", "items": {"$ref": "#/$defs/storyObject"}, "minItems": 0, "maxItems": 16},
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "placeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "goal",
          "placeId"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "actorId",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "layout": {
      "type": "object",
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "placeId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "space": {
                "enum": [
                  "indoor",
                  "outdoor"
                ]
              },
              "grid": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "level": {
                "enum": [-1, 0]
              },
              "floor": {
                "enum": [
                  "default:wood",
                  "default:bookshelf",
                  "default:glass",
                  "default:stonebrick",
                  "default:stone",
                  "default:cobble",
                  "default:brick"
                ]
              },
              "wall": {
                "enum": [
                  "default:wood",
                  "default:bookshelf",
                  "default:glass",
                  "default:stonebrick",
                  "default:stone",
                  "default:cobble",
                  "default:brick"
                ]
              },
              "ceiling": {
                "enum": [
                  "default:wood",
                  "default:bookshelf",
                  "default:glass",
                  "default:stonebrick",
                  "default:stone",
                  "default:cobble",
                  "default:brick"
                ]
              },
              "apron": {
                "enum": [
                  "default:wood",
                  "default:bookshelf",
                  "default:glass",
                  "default:stonebrick",
                  "default:stone",
                  "default:cobble",
                  "default:brick"
                ]
              },
              "windows": {
                "type": "boolean"
              },
              "blueprint": {
                "enum": [
                  "victorian_sitting_room_v1"
                ]
              }
            },
            "required": [
              "placeId",
              "space",
              "grid"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {"level": {"const": -1}},
                  "required": ["level"]
                },
                "then": {
                  "properties": {"space": {"const": "indoor"}}
                }
              },
              {
                "if": {
                  "required": [
                    "blueprint"
                  ]
                },
                "then": {
                  "properties": {
                    "space": {
                      "const": "indoor"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "floor"
                        ]
                      },
                      {
                        "required": [
                          "wall"
                        ]
                      },
                      {
                        "required": [
                          "ceiling"
                        ]
                      },
                      {
                        "required": [
                          "apron"
                        ]
                      },
                      {
                        "required": [
                          "windows"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 16
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "places",
        "connections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "description",
    "places",
    "actors",
    "memories",
    "rules",
    "layout"
  ],
  "additionalProperties": false
}
